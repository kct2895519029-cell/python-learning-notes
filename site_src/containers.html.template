<script id="method-data" type="application/json">__METHOD_JSON__</script>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('method-data').textContent);
const byId=Object.fromEntries(DATA.map(x=>[x.id,x]));
const names={list:'列表 list',dict:'字典 dict',tuple:'元组 tuple',set:'集合 set'};
const colors={list:'#5662de',dict:'#008f81',tuple:'#d39532',set:'#be659a'};
let category='list',selected='list.append',query='';
let mastered=new Set();
try{mastered=new Set(JSON.parse(localStorage.getItem('pycontainer mastered v1')||'[]'));}catch(_){}
const esc=(str)=>String(str??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
const $=(id)=>document.getElementById(id);
const classOf=(x)=> x.mutate==='否'||x.mutate.startsWith('否：')?'green':x.mutate.startsWith('是')?'amber':'';
function renderCategories(){
 $('categories').innerHTML=Object.entries(names).map(([key,val])=>`<button class="catbtn ${category===key?'active':''}" data-cat="${key}">${esc(key)}<span>${DATA.filter(x=>x.cat===key).length} 个方法</span></button>`).join('');
 document.querySelectorAll('[data-cat]').forEach(btn=>btn.addEventListener('click',()=>{category=btn.dataset.cat;query='';$('search').value='';selected=DATA.find(x=>x.cat===category).id;render();}));
}
function filtered(){return DATA.filter(x=>x.cat===category && (x.id+' '+x.sig+' '+x.desc+' '+x.cost+' '+x.pitfalls.join(' ')+' '+x.label).toLowerCase().includes(query.toLowerCase()));}
function renderNav(){
 let arr=filtered();$('methodNav').innerHTML=arr.length?arr.map(x=>`<button class="navitem ${selected===x.id?'active':''}" data-id="${esc(x.id)}"><code>${esc(x.name)}()</code>${mastered.has(x.id)?'<span class="check" aria-label="已掌握">✓</span>':''}</button>`).join(''):'<div class="empty">没有找到相关方法</div>';
 $('groupLabel').textContent=query?`检索结果 · ${arr.length} 项`:`${names[category]} · ${arr.length} 个方法`;
 document.querySelectorAll('[data-id]').forEach(btn=>btn.addEventListener('click',()=>openMethod(btn.dataset.id)));
 $('progressStat').innerHTML=`<strong>${mastered.size}/${DATA.length}</strong> 已掌握`;
 document.querySelectorAll('[data-topic]').forEach(b=>b.classList.toggle('active',selected==='topic.'+b.dataset.topic));
}
function cellsHtml(data,previous=null){
 const c=data.cells;
 if(!c.length)return `<span style="color:#91a0b3;font-family:var(--mono);font-size:14px">${data.kind==='dict'?'{}':data.kind==='set'?'set()':'[] / ()'}</span>`;
 return c.map((s,i)=>{const isNew=previous!==null&&!previous.includes(s);return `<span class="cell ${isNew?'new':''}" title="${esc(s)}">${esc(s)}</span>`;}).join('');
}
function renderExtraSVG(x){
 if(x.cat!=='set'||!['union','intersection','difference','symmetric_difference','issubset','issuperset'].includes(x.name))return '';
 const n=x.name, subset=n==='issubset'||n==='issuperset';
 const defs=`<defs><clipPath id="rightClip"><circle cx="231" cy="101" r="69"/></clipPath><mask id="onlyA" maskUnits="userSpaceOnUse" x="70" y="15" width="250" height="175"><circle cx="162" cy="101" r="69" fill="white"/><circle cx="231" cy="101" r="69" fill="black"/></mask><mask id="onlyB" maskUnits="userSpaceOnUse" x="70" y="15" width="250" height="175"><circle cx="231" cy="101" r="69" fill="white"/><circle cx="162" cy="101" r="69" fill="black"/></mask></defs>`;
 let shapes='';
 if(subset){
  shapes=`<circle cx="197" cy="101" r="79" fill="#d5f5eb" stroke="#1da48c" stroke-width="2.5"/><circle cx="194" cy="100" r="42" fill="#a9b5ff" stroke="#5366db" stroke-width="2.5"/><text x="194" y="105" text-anchor="middle" fill="#243ab9" font-weight="750" font-size="17">B</text><text x="235" y="53" fill="#087e73" font-weight="750" font-size="17">A</text>`;
  if(n==='issubset') shapes=`<circle cx="197" cy="101" r="79" fill="#d5f5eb" stroke="#1da48c" stroke-width="2.5"/><circle cx="194" cy="100" r="42" fill="#a9b5ff" stroke="#5366db" stroke-width="2.5"/><text x="194" y="105" text-anchor="middle" fill="#243ab9" font-weight="750" font-size="17">A</text><text x="235" y="53" fill="#087e73" font-weight="750" font-size="17">B</text>`;
 } else {
  const lines=`<circle cx="162" cy="101" r="69" fill="none" stroke="#596ce1" stroke-width="2.2"/><circle cx="231" cy="101" r="69" fill="none" stroke="#21a892" stroke-width="2.2"/>`;
  if(n==='union')shapes=`<circle cx="162" cy="101" r="69" fill="#9aa8fa" fill-opacity=".83"/><circle cx="231" cy="101" r="69" fill="#82dac4" fill-opacity=".75"/>${lines}`;
  if(n==='intersection')shapes=`<circle cx="162" cy="101" r="69" fill="#6a77e6" clip-path="url(#rightClip)"/>${lines}`;
  if(n==='difference')shapes=`<rect x="85" y="25" width="230" height="160" fill="#8797f3" mask="url(#onlyA)"/>${lines}`;
  if(n==='symmetric_difference')shapes=`<rect x="85" y="25" width="230" height="160" fill="#8797f3" mask="url(#onlyA)"/><rect x="85" y="25" width="230" height="160" fill="#7bd8bb" mask="url(#onlyB)"/>${lines}`;
  shapes+=`<text x="114" y="103" fill="#3249b0" font-weight="700" font-size="15">A</text><text x="272" y="103" fill="#087e73" font-weight="700" font-size="15">B</text>`;
 }
 const notes={union:'A ∪ B：两圆的所有区域都属于结果',intersection:'A ∩ B：只有重叠区域属于结果',difference:'A − B：只有 A 独有的区域属于结果',symmetric_difference:'A △ B：去掉重叠区，只保留两侧独有区域',issubset:'A ⊆ B：A 的全部成员都包含在 B 内',issuperset:'A ⊇ B：A 包含 B 的全部成员'};
 return `<div class="svgviz"><svg viewBox="0 0 400 204" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${esc(notes[n])}" preserveAspectRatio="xMidYMid meet">${defs}${shapes}</svg><div><strong>集合关系 · 维恩图</strong><p>${esc(notes[n])}</p><small>几何区域只代表元素集合关系，不表示集合在内存中的位置。</small></div></div>`;
}
function renderDiagram(x){
 const a=x.before,b=x.after;
 return `<div class="diagram"><div class="diagrow"><div><div class="diagtitle">操作前${a.heading?' · '+esc(a.heading):''}</div><div class="cells">${cellsHtml(a)}</div></div><div class="arrow" aria-hidden="true">→</div><div><div class="diagtitle">操作后 / 返回结果${b.heading?' · '+esc(b.heading):''}</div><div class="cells">${cellsHtml(b,a.cells)}</div></div></div>${renderExtraSVG(x)}<div class="diagramnote">${esc(x.diagram_note)}<br><span style="opacity:.75">注：为理解概念而绘制，元素的图中位置不代表 set 的实际迭代顺序。</span></div></div>`;
}
function renderMethod(x){
 const arr=DATA.filter(y=>y.cat===x.cat),idx=arr.findIndex(y=>y.id===x.id),prev=arr[idx-1],next=arr[idx+1];
 return `<article class="panel"><div class="crumb">PYTHON 容器 <span>›</span> ${esc(names[x.cat])} <span>›</span> <strong>${esc(x.name)}()</strong></div>
 <div class="methodtitle"><div><h2>${esc(x.name)}()</h2><p>${esc(x.desc)}</p></div><button class="mark ${mastered.has(x.id)?'done':''}" id="mark">${mastered.has(x.id)?'✓ 已掌握':'○ 标记已掌握'}</button></div>
 <div class="pillrow"><span class="pill">${esc(x.cost)}</span><span class="pill ${classOf(x)}">${esc(x.mutate)}</span><span class="pill">返回 ${esc(x.ret)}</span></div><div class="signature"><span class="prefix">Python </span>${esc(x.sig)}</div>
 <div class="section"><div class="sectionheader"><h3>01 / 操作示意图</h3><small>从变化理解方法</small></div>${renderDiagram(x)}</div>
 <div class="section"><div class="sectionheader"><h3>02 / 可直接运行的代码</h3><small>复制后粘贴进 PyCharm</small></div><div class="codepanel"><div class="codehead"><span>EXAMPLE.PY</span><button class="copy" id="copy">复制代码</button></div><pre><code>${esc(x.code)}</code></pre></div><div class="output"><div class="outhead">✓ 已验证的参考输出</div><pre>${esc(x.output)}</pre></div></div>
 <div class="section"><div class="sectionheader"><h3>03 / 逐步解释</h3><small>对应上面的 Python 代码</small></div><ol class="steps">${x.steps.map(s=>`<li>${esc(s)}</li>`).join('')}</ol></div>
 <div class="section"><div class="sectionheader"><h3>04 / 参数与返回值</h3></div>${x.params.length?x.params.map(q=>`<div class="param"><div><div class="paramcode">${esc(q.name)}</div><div class="paramtype">${esc(q.type)}</div></div><div class="paramdesc">${esc(q.desc)}</div></div>`).join(''):'<div class="no-param">本方法不需要额外参数；调用时保留空括号 ()。</div>'}<div class="explainbox"><h3>返回值 · ${esc(x.ret)}</h3><p>注意区分「方法修改了容器」与「方法返回了什么」。两者是独立的事情。${x.mutate.startsWith('是')?'该方法会直接修改原容器，不能把它的返回值误当作修改后的容器。':''}</p></div></div>
 <div class="section"><div class="sectionheader"><h3>05 / 时间复杂度为何如此</h3></div><div class="fact"><div class="factlabel">CPYTHON / COMMON CASE</div><div class="factvalue">${esc(x.cost)}</div><div class="facttext">${esc(x.why)}</div></div></div>
 <div class="section"><div class="sectionheader"><h3>06 / 高频易错点</h3></div><div class="warnings">${x.pitfalls.map(t=>`<div class="warning"><span class="ico">!</span><span>${esc(t)}</span></div>`).join('')}</div></div>
 <div class="section"><div class="sectionheader"><h3>07 / 容易混淆的方法</h3><small>点击跳转对比</small></div><div class="related">${x.related.map(id=>`<button class="rel" data-related="${esc(id)}">${esc(id)}()</button>`).join('')||'暂无'}</div></div></article>
 <div class="navbottom"><button id="previous" ${!prev?'disabled':''}>← ${prev?esc(prev.name)+'()':'已到开头'}</button><button id="next" ${!next?'disabled':''}>${next?esc(next.name)+'()':'已到结尾'} →</button></div>`;
}
function renderOverview(){
 return `<section class="panel"><div class="crumb">PYTHON 容器 › <strong>基础概念</strong></div><h2 class="introtitle">先分清四种容器</h2><p class="introdesc">容器是用来组织多个数据对象的数据结构。它们的核心区别是：是否有序、能否修改、是否允许重复、按什么方式查找，以及底层如何组织数据。</p><div class="introgrid">
 ${[{cat:'list',s:'[10, 20, 30]',d:'有序、可变、允许重复，按整数索引访问。底层是动态数组。',k:'查索引 O(1)，前插/前删 O(n)'},{cat:'dict',s:'{"name": "Li"}',d:'键到值的映射；可变；Python 3.7+ 保证插入顺序。键必须可哈希。',k:'按键平均 O(1)'},{cat:'tuple',s:'(10, 20)',d:'有序、不可变、允许重复；但内部所引用的可变对象仍可变化。',k:'取索引 O(1)，查值 O(n)'},{cat:'set',s:'{10, 20}',d:'可变、无固定顺序、自动去重；元素必须可哈希。',k:'成员判断平均 O(1)'}].map(z=>`<button class="infocard" data-go="${z.cat}"><span class="mini">${esc(z.cat)}</span><h3>${esc(names[z.cat])}</h3><p style="font-family:var(--mono);margin-bottom:8px;color:#3446a9">${esc(z.s)}</p><p>${esc(z.d)}</p><p style="margin-top:9px;font-weight:700;color:#5267b0">${esc(z.k)}</p></button>`).join('')}</div>
 <div class="section"><div class="sectionheader"><h3>基础术语（点击展开）</h3></div>${glossary.map(g=>`<details class="explainbox"><summary style="font-weight:800;cursor:pointer">${esc(g[0])}</summary><p style="margin-top:10px">${esc(g[1])}</p></details>`).join('')}</div>
 <div class="notefoot"><strong>边界纠正：</strong>元组不支持原地增删改，但不是“所有操作都会返回新元组”。len(t) 返回整数，x in t 返回布尔值；某些完整切片可直接复用原元组对象。</div></section>`;
}
const glossary=[
 ['可迭代对象 iterable','能够一个接一个提供元素的对象。例如 [2, 3]、(2, 3)、"ab"、{2, 3}。extend("ab") 会依次得到字符 a 和 b。'],
 ['索引 index / 切片 slice','索引像编号，如 a[0] 是第一个元素；切片 a[1:3] 取下标 1 和 2，不包含下标 3。'],
 ['键 key / 值 value','字典里的键是查找标签，例如 {"age":20} 中 "age" 是键，20 是值；d["age"] 取值。'],
 ['可哈希 hashable','能计算稳定哈希值且满足相等关系约束的对象。字符串、整数、仅含可哈希元素的元组通常可以；普通 list/dict/set 不行。'],
 ['动态视图 view','字典 keys()/values()/items() 返回的“观察窗口”；不是当时的数据快照。新增键之后再读视图，会看到最新内容。'],
 ['原地修改 in-place','直接改变传入容器本身，例如 a.sort()；原来指向该容器的其他变量也能看到变化。'],
 ['浅拷贝 shallow copy','只新建最外层容器，内部对象仍可能共享。例如 [[1]].copy() 的第一层 list 复制了，但里面的 [1] 没复制。'],
 ['均摊 O(1)','多数调用成本很小，偶尔扩容成本较高；把大量调用总成本平均后，每次仍为常数级。'],
 ['O(n) / O(n log n)','n 通常指容器当前元素数量。O(n) 随元素数量线性增长；O(n log n) 常见于比较排序。只是增长数量级，不等于精确耗时。'],
 ['== 与 is','== 比较对象是否相等，is 比较是不是同一个对象。1 == True 为真，但 1 is True 为假。']
];
const genericPitfalls=[
 ['遍历时修改容器','列表原地删除可能跳过下一个元素；字典/集合遍历期间改变大小可能抛 RuntimeError。通常先构造新容器，或在副本上遍历，或先收集待删除项。','a = [1, 2, 2, 3]\na = [x for x in a if x != 2]\nprint(a)','list.remove'],
 ['修改原对象与重新赋值','a.clear() 会清空同一个对象；a = [] 只是让名字 a 指向新对象，其他别名不会跟着变。','a = [1, 2]\nb = a\na = []\nprint(b)','list.clear'],
 ['浅拷贝共享嵌套对象','a.copy() 仅创建新外层对象；嵌套列表还是共享的。只有确实需要完全独立时，再考虑 deepcopy。','a = [[1]]\nb = a.copy()\nb[0].append(2)\nprint(a)','list.copy'],
 ['== 并非类型严格相等','Python 的 True == 1 和 1 == 1.0 为 True；列表 count 与集合去重遵守相等语义。','print([1, True, 1.0].count(1))\nprint(len({1, True, 1.0}))','list.count'],
 ['集合的 pop 不是随机抽样','set.pop() 任意移除一个元素；不能假定具体是哪个，更不能把它当成等概率抽样。','s = {1, 2, 3}\nx = s.pop()\nprint(len(s))','set.pop'],
 ['集合方法与运算符支持的输入不同','a.union([3]) 支持传入列表；a | [3] 通常 TypeError。方法常接受任意可迭代对象，运算符一般要求集合类对象。','a = {1, 2}\nprint(sorted(a.union([3])))','set.union'],
 ['复杂度有前提','哈希表的平均 O(1) 假设键的哈希和相等判断成本合理且冲突少；set 操作涉及普通 iterable 时复杂度可能不同。','a = {1, 2}\nprint(a.issubset([1, 2, 3]))','set.issubset'],
 ['Python 的空集合不是 {}','{} 创建空字典；空集合需要 set()。','print(type({}).__name__)\nprint(type(set()).__name__)','set.clear']
];
function renderPitfalls(){
 return `<section class="panel"><div class="crumb">PYTHON 容器 › <strong>高频踩坑</strong></div><h2 class="introtitle">8 个必须掌握的共性陷阱</h2><p class="introdesc">这些问题不是孤立的 API 记忆题，而是关系到容器的引用、迭代、相等性与时间复杂度的核心概念。</p>${genericPitfalls.map((z,i)=>`<div class="explainbox"><h3>${String(i+1).padStart(2,'0')} · ${esc(z[0])}</h3><p>${esc(z[1])}</p><pre style="font-family:var(--mono);white-space:pre-wrap;line-height:1.7;background:#f1f5fa;padding:12px;border-radius:10px;color:#27364a">${esc(z[2])}</pre><button class="rel" data-related="${esc(z[3])}">查看 ${esc(z[3])}() 详解</button></div>`).join('')}
 <div class="notefoot"><strong>原表修正摘要：</strong>set.pop() 是“任意弹出”，不是随机抽样；sort 的混合类型并非必然 TypeError；index/count 依赖 ==，不是严格类型匹配；集合运算的复杂度要看操作对象是否都是 set；元组方法不能与通用运算混为一谈。</div></section>`;
}
function render(){
 renderCategories();renderNav();
 const x=byId[selected];$('main').innerHTML=x?renderMethod(x):selected==='topic.overview'?renderOverview():renderPitfalls();
 if(x){
 $('mark').onclick=()=>{mastered.has(x.id)?mastered.delete(x.id):mastered.add(x.id);try{localStorage.setItem('pycontainer mastered v1',JSON.stringify([...mastered]));}catch(_){}render();};
 $('copy').onclick=()=>copyCode(x.code);
 const arr=DATA.filter(y=>y.cat===x.cat),index=arr.findIndex(y=>y.id===x.id);
 if(index>0)$('previous').onclick=()=>openMethod(arr[index-1].id);
 if(index<arr.length-1)$('next').onclick=()=>openMethod(arr[index+1].id);
 }
 document.querySelectorAll('[data-related]').forEach(b=>b.onclick=()=>openMethod(b.dataset.related));
 document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>openMethod(DATA.find(x=>x.cat===b.dataset.go).id));
}
function copyCode(code){
 const button=$('copy');
 if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(code).then(()=>{button.textContent='✓ 已复制';setTimeout(()=>button.textContent='复制代码',1500)}).catch(()=>legacyCopy(code,button));} else legacyCopy(code,button);
}
function legacyCopy(code,button){
 const el=document.createElement('textarea');el.value=code;el.style.position='fixed';el.style.left='-10000px';document.body.appendChild(el);el.select();let ok=false;try{ok=document.execCommand('copy');}catch(_){}el.remove();button.textContent=ok?'✓ 已复制':'请手动选中复制';setTimeout(()=>button.textContent='复制代码',1800);
}
function openMethod(id){if(!byId[id])return;category=byId[id].cat;selected=id;query='';$('search').value='';render();scrollTo({top:0,behavior:'smooth'});try{history.replaceState(null,'','#'+encodeURIComponent(id));}catch(_){}}
$('search').addEventListener('input',e=>{query=e.target.value.trim();if(!byId[selected] || byId[selected].cat!==category)selected=DATA.find(x=>x.cat===category).id;renderNav();});
document.querySelectorAll('[data-topic]').forEach(b=>b.onclick=()=>{selected='topic.'+b.dataset.topic;render();scrollTo({top:0,behavior:'smooth'});});
document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('search').focus();}if(e.key==='Escape'&&document.activeElement===$('search')){$('search').value='';query='';renderNav();$('search').blur();}});
const hash=decodeURIComponent(location.hash.replace(/^#/,''));if(byId[hash]){selected=hash;category=byId[hash].cat;}
render();
</script></body></html>